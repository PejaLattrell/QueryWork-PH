SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
# Optional for dashboard reads; required by the Python collector. Keep server-only.
SUPABASE_SERVICE_ROLE_KEY=
INGESTION_LANDING_DIR=data/landing
APP_ENV=development
# Required in production. Users supply this in the dashboard or X-Scrape-Token header.
APP_TRIGGER_TOKEN=
SCRAPE_COOLDOWN_SECONDS=300
# Optional operator-maintained USD per currency unit. Unknown FX remains unnormalized.
FX_USD_RATES={}
