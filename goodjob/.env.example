SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
# n8n uses this server-only legacy service_role JWT for writes. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/goodjob-trigger
APP_ENV=development
# Required in production. Users supply this in the dashboard or X-Scrape-Token header.
APP_TRIGGER_TOKEN=
SCRAPE_COOLDOWN_SECONDS=300
# Optional operator-maintained USD per currency unit. Unknown FX remains unnormalized.
FX_USD_RATES={}
