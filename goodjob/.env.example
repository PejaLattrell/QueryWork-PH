SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
# Server-only; used after a source adapter is selected. A key alone does not enable ingestion.
SUPABASE_SERVICE_ROLE_KEY=
INGESTION_LANDING_DIR=.local/ingestion
APP_ENV=development
# Required in production. Users supply this in the dashboard or X-Scrape-Token header.
APP_TRIGGER_TOKEN=
SCRAPE_COOLDOWN_SECONDS=300
# Optional operator-maintained USD per currency unit. Unknown FX remains unnormalized.
FX_USD_RATES={}
